{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/app/(sw.js|app.js|config.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/join",
      "destination": "/app"
    },
    {
      "source": "/join/:rest*",
      "destination": "/app"
    },
    {
      "source": "/u/:username",
      "destination": "/link"
    },
    {
      "source": "/user/:username",
      "destination": "/link"
    },
    {
      "source": "/post/:id",
      "destination": "/link"
    },
    {
      "source": "/venue/:id",
      "destination": "/link"
    },
    {
      "source": "/events",
      "destination": "/link"
    },
    {
      "source": "/scan/:code",
      "destination": "/app"
    },
    {
      "source": "/app/:path((?!.*\\.).*)",
      "destination": "/app"
    }
  ]
}
